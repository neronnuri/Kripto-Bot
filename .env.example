# Bu dosyayı ".env" adıyla kopyalayıp doldur. .env dosyası GitHub'a yüklenmez.

EXCHANGE=binance
API_KEY=buraya_api_key
API_SECRET=buraya_api_secret

SYMBOL=BTC/USDT
TRADE_USDT=6
TAKE_PROFIT_PCT=1
# 0 = stop-loss kapalı
STOP_LOSS_PCT=0
SL_COOLDOWN_MIN=30
MAX_DAILY_LOSS_USDT=10

# false = GERÇEK PARA, true = simülasyon
PAPER=false

TELEGRAM_TOKEN=buraya_bot_token
TELEGRAM_CHAT_ID=buraya_chat_id
DAILY_REPORT_HOUR=23
TIMEZONE=Europe/Istanbul
